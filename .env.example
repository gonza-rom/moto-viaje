# Copiar a .env.local (o .env) y completar. Este archivo SÍ se sube a git: nunca pongas valores reales acá.

# Acceso (contraseña única, solo vos)
APP_PASSWORD=
# String largo y aleatorio: openssl rand -hex 32
AUTH_SECRET=

# Supabase (solo como base de datos; la service role key NUNCA va al cliente)
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://postgres.TU-PROYECTO:[YOUR-PASSWORD]@aws-0-us-east-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://postgres.TU-PROYECTO:[YOUR-PASSWORD]@aws-0-us-east-2.pooler.supabase.com:5432/postgres"

# Cloudinary (fotos, videos y GPX)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=moto-viajes
# Tamaño máximo por video en MB (plan gratuito: 100)
NEXT_PUBLIC_CLOUDINARY_MAX_VIDEO_MB=100
